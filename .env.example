# Postgres connection string. In production, Neon's pooled URL.
DATABASE_URL="postgres://user:password@host:5432/db-name"
# Optional: direct (unpooled) Neon URL used for migrations. Vercel's Neon integration sets this.
DATABASE_URL_UNPOOLED=""
# First account. Only used while no account exists; remove ADMIN_PASSWORD after your first login.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Optional: Claude API key for AI-drafted examples and prefix-meaning suggestions.
ANTHROPIC_API_KEY=""
